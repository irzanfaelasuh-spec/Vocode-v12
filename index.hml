FM('dev','.*','Regex Tester','Mencoba Regular Expression',{in:[{l:'Pattern',ph:'\\d+'},{l:'Flags',d:'g'},{l:'Text',ta:4}],live:1,go:v=>{if(!v[0])return 'enter a pattern';const re=new RegExp(v[0],v[1].includes('g')?v[1]:v[1]+'g'),m=[...v[2].matchAll(re)].slice(0,200);return m.length?m.length+' match(es)\n'+m.map((x,i)=>'#'+(i+1)+' @'+x.index+'  "'+x[0]+'"'+(x.length>1?'  groups: '+x.slice(1).join(' | '):'')).join('\n'):'no match'}});
FM('dev','⇢','Base64 Encoder','Mengubah teks menjadi Base64',{ed:1,in:[{l:'Text',ta:4}],live:1,go:v=>b64e(v[0])});
FM('dev','⇠','Base64 Decoder','Mengubah Base64 kembali menjadi teks',{in:[{l:'Base64',ta:4}],live:1,go:v=>b64d(v[0])});
FM('dev','%','URL Encoder','Melakukan URL encoding',{in:[{l:'Text',ta:3}],live:1,go:v=>encodeURIComponent(v[0])});
FM('dev','%','URL Decoder','Melakukan URL decoding',{in:[{l:'Encoded',ta:3}],live:1,go:v=>decodeURIComponent(v[0])});
FM('dev','#','UUID Generator','Membuat UUID random',{in:[{l:'Count',d:'5'}],btn:'⚡ Generate',auto:1,go:v=>Array.from({length:clamp(+v[0]||1,1,50)},()=>crypto.randomUUID()).join('\n')});
FM('dev','#','Hash Generator','Membuat hash dari teks',{w:520,in:[{l:'Text',ta:3}],live:1,go:async v=>{const d=new TextEncoder().encode(v[0]);let o='';for(const a of['SHA-1','SHA-256','SHA-384','SHA-512'])o+=a.padEnd(8)+hex(await crypto.subtle.digest(a,d))+'\n';return o}});
FM('dev','◉','Color Picker','Memilih warna dan mendapatkan HEX/RGB',{html:1,in:[{l:'Pick a color',t:'color',d:'#38bdf8'}],live:1,auto:1,go:colorOut});
FM('dev','◐','Color Converter','Mengubah HEX ↔ RGB ↔ HSL',{html:1,in:[{l:'HEX / rgb() / hsl()',d:'#38bdf8'}],live:1,go:colorOut});
FM('dev','◷','Timestamp Converter','Mengubah timestamp menjadi tanggal/waktu',{in:[{l:'Unix timestamp or date (empty = now)'}],live:1,auto:1,go:v=>{let d;const s=v[0].trim();if(!s)d=new Date();else if(/^-?\d+(\.\d+)?$/.test(s)){const n=+s;d=new Date(Math.abs(n)<1e11?n*1000:n)}else d=new Date(s);if(isNaN(d))throw Error('invalid date');return 'ISO     '+d.toISOString()+'\nLocal   '+d.toString()+'\nUnix s  '+Math.floor(d/1000)+'\nUnix ms '+d.getTime()}});
FM('dev','¶','Text Counter','Menghitung karakter/kata/baris',{ed:1,in:[{l:'Text',ta:5}],live:1,auto:1,go:v=>{const t=v[0],w=(t.trim().match(/\S+/g)||[]).length;return 'chars       '+t.length+'\nno spaces   '+t.replace(/\s/g,'').length+'\nwords       '+w+'\nlines       '+(t?t.split('\n').length:0)+'\nsentences   '+((t.match(/[.!?]+(\s|$)/g)||[]).length)+'\nread time   ~'+Math.max(1,Math.round(w/200))+' min'}});
FM('dev','▦','QR Generator','Membuat QR dari teks atau URL',{html:1,in:[{l:'Text or URL',d:'https://example.com'}],live:1,auto:1,go:v=>{if(!window.qrcode)throw Error('QR library failed to load');if(!v[0])return 'type something';const r=qrcode(0,'M');r.addData(v[0]);r.make();return '<div style="background:#fff;padding:10px;border-radius:10px;display:inline-block">'+r.createSvgTag({cellSize:5,margin:2})+'</div>'}});
FM('dev','¶','Lorem Generator','Membuat teks dummy',{in:[{l:'Paragraphs',d:'2'}],btn:'⚡ Generate',auto:1,go:v=>Array.from({length:clamp(+v[0]||1,1,10)},()=>{let s=[];for(let i=0;i<40+rnd(30);i++)s.push(pool[rnd(pool.length)]);const t=s.join(' ');return t[0].toUpperCase()+t.slice(1)+'.'}).join('\n\n')});

/* ── WEB TOOLS ── */
const browser=n=>add('web','◍',n,n==='Browser'?'Browser mini di dalam VOCODE':'Membuka URL dalam window VOCODE',()=>{
 const w=makeWin('b:'+n,TT(n),520);if(!w)return;
 w.body.innerHTML='<div class="twF"><input value="https://example.com"><iframe sandbox="allow-scripts allow-same-origin allow-forms allow-popups"></iframe><div class="dimtxt">Sites that forbid embedding stay blank.</div></div>';
 const i=w.body.querySelector('input'),f=w.body.querySelector('iframe'),go=()=>{let u=i.value.trim();if(!/^https?:/.test(u))u='https://'+u;i.value=u;f.src=u};i.onkeydown=e=>e.key==='Enter'&&go();go()});
browser('Browser');browser('URL Viewer');
FM('web','‹›','Page Source','Melihat source HTML halaman',{w:520,in:[{l:'URL',d:'https://example.com'}],btn:'⤓ Fetch',go:async v=>(await (await fetch(v[0])).text()).slice(0,20000)});
const api=m=>({w:500,in:[{l:'Method',o:['GET','POST','PUT','PATCH','DELETE']},{l:'URL',d:'https://api.github.com/zen'},{l:'Headers (JSON)',ta:2,ph:'{"Authorization":"Bearer …"}'},{l:'Body',ta:3}],btn:'▶ Send',go:async v=>{const t=performance.now(),o={method:v[0]};if(v[2].trim())o.headers=JSON.parse(v[2]);if(v[3].trim()&&v[0]!=='GET')o.body=v[3];const r=await fetch(v[1],o),tx=await r.text();let b=tx;try{b=JSON.stringify(JSON.parse(tx),null,2)}catch{}const h=[...r.headers].map(x=>x[0]+': '+x[1]).join('\n'),s=r.status+' '+r.statusText+' · '+Math.round(performance.now()-t)+' ms · '+tx.length+' B';return m==='h'?s+'\n\n'+h:m==='r'?s+'\n\n'+b:s+'\n\n'+h+'\n\n'+b}});
FM('web','⇄','HTTP Tester','Mengetes request HTTP',api('a'));FM('web','⇄','API Tester','Mengirim request ke API',api('a'));
FM('web','☰','Headers Viewer','Melihat HTTP headers',api('h'));FM('web','☷','Response Viewer','Melihat response API',api('r'));
FM('web','◫','Website Inspector','Memeriksa struktur halaman',{auto:1,btn:'↻ Inspect index.html',go:()=>{const d=new DOMParser().parseFromString(files().html,'text/html'),a=d.querySelectorAll('*'),c={};a.forEach(e=>c[e.tagName.toLowerCase()]=(c[e.tagName.toLowerCase()]||0)+1);const top=Object.entries(c).sort((x,y)=>y[1]-x[1]).slice(0,8).map(x=>x[0]+'×'+x[1]).join('  ');
 return 'elements   '+a.length+'\ntop tags   '+top+'\nheadings   '+d.querySelectorAll('h1,h2,h3,h4,h5,h6').length+'\nlinks      '+d.querySelectorAll('a').length+'\nimages     '+d.querySelectorAll('img').length+' ('+d.querySelectorAll('img:not([alt])').length+' without alt)\nscripts    '+d.querySelectorAll('script').length+'\n\n'+[['<title>',d.title],['lang attr',d.documentElement.getAttribute('lang')],['viewport meta',d.querySelector('meta[name=viewport]')]].map(x=>(x[1]?'✓ ':'✗ ')+x[0]).join('\n')}});
FM('web','◔','Cookie Viewer','Melihat cookie yang tersedia',{auto:1,btn:'↻ Refresh',go:()=>document.cookie?document.cookie.split('; ').map(c=>c.replace('=','  =  ')).join('\n'):'no cookies (file:// pages have none)'});
FM('web','▤','Local Storage','Melihat data LocalStorage',{auto:1,html:1,w:440,btn:'↻ Refresh',pick:(p,w)=>{if(confirm('Delete "'+p.dataset.p+'"?')){localStorage.removeItem(p.dataset.p);w.body.querySelector('[data-a=run]').click()}},go:()=>Object.keys(localStorage).map(k=>'<div class="hit" data-p="'+esc(k)+'" title="click to delete"><b>'+esc(k)+'</b>'+(localStorage.getItem(k).length/1024).toFixed(1)+' KB ✕</div>').join('')||'empty'});

/* ── UI / WINDOW ── */
const TH={Midnight:{},Ocean:{'--bg':'#04121b','--surface':'#071a26','--surface2':'#0a2231','--surface3':'#0e2d40','--border':'#123449','--border2':'#1d5678','--blue':'#22d3ee'},Emerald:{'--bg':'#040f0b','--surface':'#071711','--surface2':'#0a2018','--surface3':'#0f2c21','--border':'#143528','--border2':'#1f5a44','--blue':'#34d399'},Violet:{'--bg':'#0a0713','--surface':'#0f0b1c','--surface2':'#151027','--surface3':'#1c1534','--border':'#2a2048','--border2':'#43337a','--blue':'#a78bfa'},Ember:{'--bg':'#100a06','--surface':'#160e08','--surface2':'#1e130b','--surface3':'#28180d','--border':'#3a2413','--border2':'#6b4220','--blue':'#fb923c'},Graphite:{'--bg':'#0b0b0d','--surface':'#111114','--surface2':'#17171b','--surface3':'#1e1e24','--border':'#2a2a32','--border2':'#43434f','--blue':'#e2e8f0'}};
const VARS=['--bg','--surface','--surface2','--surface3','--border','--border2','--blue'];
function theme(n,e,keep){const r=document.documentElement;VARS.forEach(k=>r.style.removeProperty(k));Object.entries(TH[n]||{}).forEach(([k,v])=>r.style.setProperty(k,v));if(!keep)localStorage.removeItem('VOCODE_ACCENT');ss('VOCODE_THEME',n);if(e){r.classList.add('themeFx');setTimeout(()=>r.classList.remove('themeFx'),800);wave(e.clientX,e.clientY)}}
try{const t=ls('VOCODE_THEME','Midnight');if(TH[t])theme(t,0,1);const a=localStorage.getItem('VOCODE_ACCENT');if(a)document.documentElement.style.setProperty('--blue',JSON.parse(a))}catch{}
add('ui','◐','Theme Manager','Mengganti tema VOCODE',()=>{const w=makeWin('themes',TT('Themes'),340);if(!w)return;
 w.body.innerHTML='<div class="thmG">'+Object.keys(TH).map(n=>'<button class="thm" data-n="'+n+'" style="--a:'+(TH[n]['--blue']||'#38bdf8')+';--b:'+(TH[n]['--surface']||'#0a1018')+'"><i></i>'+n+'</button>').join('')+'</div>';
 w.body.onclick=e=>{const b=e.target.closest('.thm');if(b){theme(b.dataset.n,e);toast('Theme: '+b.dataset.n)}}});
FM('ui','◉','Accent Color','Mengubah warna aksen UI',{in:[{l:'Accent',t:'color',d:'#38bdf8'}],live:1,go:v=>{document.documentElement.style.setProperty('--blue',v[0]);ss('VOCODE_ACCENT',v[0]);return '✓ accent '+v[0]}});
FM('ui','Aa','Font Settings','Mengganti font editor',{in:[{l:'Editor font',o:['JetBrains Mono','Fira Code','Consolas','Courier New','ui-monospace'],d:'JetBrains Mono'}],live:1,go:v=>{const c=cm();c.getWrapperElement().style.fontFamily='"'+v[0]+'",monospace';c.refresh();return '✓ '+v[0]}});
add('ui','▣','Window Manager','Mengatur semua window yang terbuka',()=>{const w=makeWin('wm',TT('Windows'),340);if(!w)return;
 const draw=()=>{const ks=Object.keys(W).filter(k=>k!=='wm'),s=ks.join('|');if(w.sig===s)return;w.sig=s;w.body.innerHTML='<div class="twF">'+(ks.map(k=>'<div class="snRow"><b>'+W[k].title+'</b><button class="btn" data-a="f" data-k="'+k+'">Focus</button><button class="btn" data-a="x" data-k="'+k+'">✕</button></div>').join('')||'<div class="dimtxt">no other windows</div>')+'<div class="twRow"><button class="btn" data-a="all">Close all</button></div></div>'};
 w.body.onclick=e=>{const b=e.target.closest('[data-a]');if(!b)return;const k=b.dataset.k;if(b.dataset.a==='f'&&W[k]){W[k].el.classList.remove('min');raise(W[k].el)}else if(b.dataset.a==='x'&&W[k])W[k].close();else if(b.dataset.a==='all')Object.keys(W).forEach(x=>x!=='wm'&&W[x].close())};
 draw();const t=setInterval(draw,500);w.onClose=()=>clearInterval(t)});
const tog=(c,m)=>{const r=document.documentElement;r.classList.toggle(c);wave();setTimeout(()=>cm().refresh(),350);const on=r.classList.contains(c);if(c==='zen'&&on){const h=document.createElement('div');h.className='zenHint';h.textContent='zen mode · press Esc to exit';document.body.appendChild(h);setTimeout(()=>h.remove(),2900)}else toast(m+(on?' on':' off'))};
add('ui','◎','Focus Mode','Menyembunyikan elemen yang mengganggu',()=>tog('focus','Focus mode'));
add('ui','○','Zen Mode','Membuat tampilan editor super minimal',()=>{document.documentElement.classList.add('focus');tog('zen','Zen mode')});
add('ui','⛶','Fullscreen','Membuat VOCODE fullscreen',()=>document.fullscreenElement?document.exitFullscreen():document.documentElement.requestFullscreen().catch(()=>toast('Fullscreen blocked')));
add('ui','↺','Reset Layout','Mengembalikan posisi UI ke default',()=>{document.documentElement.classList.remove('focus','zen');Object.keys(W).forEach(k=>W[k].close());frame(0,0);const c=cm();c.getWrapperElement().style.fontFamily='';c.refresh();wave();toast('✓ Layout reset')});

/* ── UTILITIES ── */
const UN={Length:{m:1,km:1e3,cm:.01,mm:.001,mi:1609.344,yd:.9144,ft:.3048,in:.0254},Mass:{kg:1,g:.001,mg:1e-6,lb:.45359237,oz:.028349523},Time:{s:1,min:60,h:3600,day:86400,week:604800},Data:{B:1,KB:1024,MB:1048576,GB:1073741824,TB:1099511627776},Speed:{'m/s':1,'km/h':1/3.6,mph:.44704,kn:.514444},Area:{m2:1,km2:1e6,ha:1e4,ft2:.09290304,acre:4046.8564224},Temp:{C:1,F:1,K:1}};
FM('util','⇌','Unit Converter','Konversi satuan',{live:1,auto:1,in:[{l:'e.g. 10 km to mi · 72 F to C · 2 GB to MB',d:'10 km to mi'}],go:v=>{const m=v[0].trim().match(/^(-?[\d.]+(?:e-?\d+)?)\s*([A-Za-z0-9\/]+)\s+(?:to|in|->|>)\s+([A-Za-z0-9\/]+)$/);if(!m)throw Error('format: 10 km to mi\n\n'+Object.entries(UN).map(([k,o])=>k+': '+Object.keys(o).join(' ')).join('\n'));const n=+m[1],c=Object.keys(UN).find(k=>m[2] in UN[k]&&m[3] in UN[k]);if(!c)throw Error('unknown or mismatched units');let r;if(c==='Temp'){const C=m[2]==='C'?n:m[2]==='F'?(n-32)*5/9:n-273.15;r=m[3]==='C'?C:m[3]==='F'?C*9/5+32:C+273.15}else r=n*UN[c][m[2]]/UN[c][m[3]];return n+' '+m[2]+' = '+(+r.toPrecision(10))+' '+m[3]}});
FM('util','∑','Scientific Calculator','Kalkulator dengan fungsi matematika tambahan',{live:1,in:[{l:'sin cos tan sqrt log ln abs pow exp pi e ^ (radians)',ph:'sin(pi/2)+sqrt(16)^2'}],go:v=>{if(!v[0].trim())return '…';return '= '+sci(v[0])}});
const base=d=>({in:[{l:'Value',ph:'255 / 11111111 / ff'},{l:'From',o:['Decimal','Binary','Hex','Octal'],d}],live:1,go:v=>{const B={Decimal:10,Binary:2,Hex:16,Octal:8}[v[1]],s=v[0].trim().replace(/^0[xb]/i,'').replace(/\s+/g,'');if(!s)return '…';const n=parseInt(s,B);if(isNaN(n)||n.toString(B)!==s.toLowerCase().replace(/^0+(?=.)/,''))throw Error('invalid '+v[1].toLowerCase()+' number');return 'Decimal  '+n+'\nBinary   '+n.toString(2)+'\nHex      '+n.toString(16).toUpperCase()+'\nOctal    '+n.toString(8)+(n>31&&n<127?'\nChar     '+String.fromCharCode(n):'')}});
FM('util','01','Binary Converter','Konversi Binary ↔ Decimal',base('Binary'));FM('util','0x','Hex Converter','Konversi Hex ↔ Decimal',base('Hex'));
FM('util','A','ASCII Table','Melihat karakter dan kode ASCII',{html:1,live:1,auto:1,w:440,in:[{l:'Filter (char, decimal or hex)',ph:'A / 65 / 0x41'}],go:v=>{const f=v[0].trim().toLowerCase();let h='';for(let i=32;i<127;i++){const c=String.fromCharCode(i);if(!f||c.toLowerCase()===f||String(i)===f||('0x'+i.toString(16))===f||i.toString(16)===f)h+='<div><b>'+esc(c)+'</b>'+i+' · 0x'+i.toString(16)+'</div>'}return '<div class="asc">'+(h||'')+'</div>'+(h?'':'no match')}});
FM('util','?','Character Inspector','Melihat detail karakter tertentu',{live:1,in:[{l:'Text',ta:2,ph:'a é 😀'}],go:v=>[...v[0]].slice(0,100).map(c=>{const p=c.codePointAt(0);return '"'+c+'"  U+'+p.toString(16).toUpperCase().padStart(4,'0')+'  dec '+p+'  utf8 '+[...new TextEncoder().encode(c)].map(b=>b.toString(16).padStart(2,'0')).join(' ')}).join('\n')||'…'});
FM('util','◷','Date Calculator','Menghitung selisih tanggal',{live:1,auto:1,in:[{l:'From',t:'date',d:new Date().toISOString().slice(0,10)},{l:'To',t:'date',d:new Date(Date.now()+864e5*30).toISOString().slice(0,10)},{l:'Add N days to “From”',d:'100'}],go:v=>{const a=new Date(v[0]),b=new Date(v[1]);if(isNaN(a)||isNaN(b))throw Error('pick both dates');const d=Math.round((b-a)/864e5),n=parseInt(v[2])||0,r=new Date(a.getTime()+n*864e5);return 'difference  '+d+' days\n            '+(d/7).toFixed(1)+' weeks\n            ~'+(d/30.4375).toFixed(1)+' months\n            ~'+(d/365.25).toFixed(2)+' years\n\nFrom + '+n+' days = '+r.toISOString().slice(0,10)}});
FM('util','⚄','Random Generator','Membuat angka/random value',{auto:1,btn:'⚡ Roll',in:[{l:'Min',d:'1'},{l:'Max',d:'100'},{l:'Count',d:'5'},{l:'Or pick from list (comma separated)',ph:'red, green, blue'}],go:v=>{const c=clamp(+v[2]||1,1,100),L=v[3].split(',').map(s=>s.trim()).filter(Boolean);if(L.length)return Array.from({length:c},()=>L[rnd(L.length)]).join('\n');const a=+v[0],b=+v[1];if(isNaN(a)||isNaN(b)||b<a)throw Error('invalid range');return Array.from({length:c},()=>a+rnd(b-a+1)).join('  ')}});
FM('util','✱','Password Generator','Membuat string random untuk testing',{auto:1,btn:'⚡ Generate',in:[{l:'Length',d:'16'},{l:'Count',d:'4'},{l:'Charset',o:['Letters+Digits+Symbols','Letters+Digits','Digits','Hex']}],go:v=>{const S={'Letters+Digits+Symbols':'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789!@#$%^&*-_=+?','Letters+Digits':'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789',Digits:'0123456789',Hex:'0123456789abcdef'}[v[2]],n=clamp(+v[0]||16,4,128);return Array.from({length:clamp(+v[1]||1,1,20)},()=>Array.from({length:n},()=>S[rnd(S.length)]).join('')).join('\n')}});

/* ── COMMAND PALETTE / QUICK OPEN ── */
function palette(items,ph){
 if(q('.pal'))return;const o=document.createElement('div');o.className='pal';o.innerHTML='<div class="palBox"><input placeholder="'+ph+'" spellcheck="false"><div class="palList"></div></div>';document.body.appendChild(o);
 const inp=o.querySelector('input'),L=o.querySelector('.palList');let sel=0,cu=[];
 const draw=()=>{const t=inp.value.toLowerCase().split(/\s+/).filter(Boolean);cu=items.filter(x=>t.every(s=>(x.n+' '+x.g+' '+x.d).toLowerCase().includes(s))).sort((a,b)=>(b.n.toLowerCase().startsWith(t[0]||'~')?1:0)-(a.n.toLowerCase().startsWith(t[0]||'~')?1:0)).slice(0,60);sel=clamp(sel,0,Math.max(0,cu.length-1));
  L.innerHTML=cu.map((x,i)=>'<button class="palRow'+(i===sel?' on':'')+'" data-i="'+i+'"><span class="vmIco">'+esc(x.i)+'</span><b>'+esc(x.n)+'</b><small>'+esc(x.d)+'</small><em>'+esc(x.g)+'</em></button>').join('')||'<div class="palEmpty">no match</div>';const a=L.querySelector('.on');a&&a.scrollIntoView({block:'nearest'})};
 const close=()=>{o.classList.remove('show');setTimeout(()=>o.remove(),260)},go=i=>{const x=cu[i];if(!x)return;close();setTimeout(x.run,170)};
 inp.oninput=()=>{sel=0;draw()};
 inp.onkeydown=e=>{if(e.key==='ArrowDown'){sel=Math.min(cu.length-1,sel+1);draw();e.preventDefault()}else if(e.key==='ArrowUp'){sel=Math.max(0,sel-1);draw();e.preventDefault()}else if(e.key==='Enter')go(sel);else if(e.key==='Escape')close()};
 L.onclick=e=>{const b=e.target.closest('.palRow');b&&go(+b.dataset.i)};o.onmousedown=e=>{if(e.target===o)close()};
 draw();requestAnimationFrame(()=>{o.classList.add('show');inp.focus()})}
const CORE=[['＋','New Project','newBtn'],['▤','Open Project','openBtn'],['▰','Import Folder','folderBtn'],['↧','Save Project','saveBtn'],['▶','Run Project','runBtn'],['■','Stop','stopBtn'],['▢','Open Screen','screenBtn'],['⇩','Export Project','exportBtn'],['✦','AI Helper','helperBtn'],['⚙','Settings','settingsBtn']].map(c=>({i:c[0],n:c[1],g:'core',d:'VOCODE',run:()=>$(c[2]).click()}));
CORE.push({i:'≡',n:'Calculator',g:'util',d:'Kalkulator floating yang bisa di-drag',run:()=>{const b=[...document.querySelectorAll('.vmItem')].find(x=>/Calculator/.test(x.textContent));b&&b.click()}},{i:'↵',n:'Toggle Word Wrap',g:'code',d:'Baris panjang turun otomatis',run:()=>{const c=cm();c.setOption('lineWrapping',!c.getOption('lineWrapping'))}});
const cmdPal=()=>palette([...CORE,...TOOLS],'Type a command…  (Ctrl+K)');
const quick=()=>{const it=Object.keys(FN).map(k=>({i:'▣',n:FN[k],g:'file',d:'Open file',run:()=>{q('.tab[data-file="'+k+'"]').click();cm().focus()}}));ls('VOCODE_PROJECTS_V3',[]).slice(0,10).forEach((p,i)=>it.push({i:'▰',n:p.name||'Untitled',g:'project',d:'Open saved project',run:()=>{const t=q('.projectItem[data-project-index="'+i+'"]');t&&t.click()}}));palette(it,'Quick open file or project…  (Ctrl+P)')};
add('code','⌘','Command Palette','Membuka semua perintah VOCODE dari satu tempat',cmdPal);
add('code','⌕','Quick Open','Mencari dan membuka file dengan cepat',quick);
document.addEventListener('keydown',e=>{const k=e.key.toLowerCase();
 if((e.ctrlKey||e.metaKey)&&!e.shiftKey&&!e.altKey&&['k','p','g','/'].includes(k)){if(k==='/'&&!e.target.closest('.CodeMirror'))return;e.preventDefault();k==='k'?cmdPal():k==='p'?quick():k==='g'?TOOLS.find(t=>t.n==='Go to Line').run():comment()}
 else if(e.key==='Escape'&&!q('.pal')&&document.documentElement.classList.contains('zen')){tog('zen','Zen mode');document.documentElement.classList.remove('focus')}},true);

/* ── MENU HUB ── */
const menu=$('vmenu'),GR=[['code','💻','Code & Editor'],['proj','📁','Project'],['run','▶️','Run & Preview'],['sys','🖥️','Terminal & System'],['dev','🧰','Developer Tools'],['web','🌐','Web Tools'],['ui','🎨','UI / Window'],['util','🧮','Utilities']];
menu.insertAdjacentHTML('beforeend','<div class="vmGroup">// tools hub · '+TOOLS.length+' tools</div>'+GR.map(g=>{const T=TOOLS.filter(t=>t.g===g[0]);return '<div class="vmCat"><button class="vmCatBtn"><span class="vmIco">'+g[1]+'</span>'+g[2]+'<span class="vmTag">'+T.length+'</span><span class="vmChev">›</span></button><div class="vmSubs"><div>'+T.map((t,j)=>'<button class="vmSub" style="--j:'+j+'" data-t="'+TOOLS.indexOf(t)+'"><span class="vmIco">'+esc(t.i)+'</span>'+esc(t.n)+'<small>'+esc(t.d)+'</small></button>').join('')+'</div></div></div>'}).join(''));
menu.addEventListener('pointerdown',e=>{const b=e.target.closest('.vmSub,.vmCatBtn');b&&ripple(b,e)});
menu.addEventListener('click',e=>{const c=e.target.closest('.vmCatBtn');if(c){const p=c.parentElement,o=p.classList.contains('open');menu.querySelectorAll('.vmCat.open').forEach(x=>x.classList.remove('open'));if(!o){p.classList.add('open');setTimeout(()=>p.scrollIntoView({block:'nearest',behavior:'smooth'}),200)}return}
 const s=e.target.closest('.vmSub');if(s){$('vmScrim').click();setTimeout(TOOLS[+s.dataset.t].run,150)}});
setTimeout(()=>{try{cm().setOption('matchBrackets',true)}catch{}},300);
})();
</script>
<script id="vocode-webcam-script">
(()=>{
'use strict';
const $=id=>document.getElementById(id),clamp=(v,a,b)=>Math.max(a,Math.min(b,v));
const toast=m=>{const el=$('toast');if(!el)return;el.textContent=m;el.classList.add('show');clearTimeout(toast.t);toast.t=setTimeout(()=>el.classList.remove('show'),1800)};
let cam=null;
const FL={Normal:'none',Mono:'grayscale(1) contrast(1.1)',Noir:'grayscale(1) contrast(1.35) brightness(.9)',Warm:'sepia(.4) saturate(1.3)',Vivid:'saturate(1.6) contrast(1.1)'};
function openCam(){
 if(cam){cam.el.classList.remove('min');cam.el.style.zIndex=93;return}
 const el=document.createElement('div');el.className='calcWin wc';el.setAttribute('role','dialog');el.setAttribute('aria-label','Webcam');
 el.innerHTML='<div class="cwSweep"><i></i></div><div class="cwBar"><div class="cwDots"><button class="dot dot-red" type="button" aria-label="Close"></button><button class="dot dot-yellow" type="button" aria-label="Minimize"></button><button class="dot dot-green" type="button" aria-label="Maximize"></button></div><div class="cwTitle"><b>await</b> webcam.js</div></div>'+
 '<div class="cwBody"><div class="wcV"><video playsinline muted autoplay></video><div class="wcCorners"></div><div class="wcLive"><i></i>LIVE</div><div class="wcInfo"></div><div class="wcMsg wait"><b>◔</b><span>Starting camera…</span></div><div class="wcFlash"></div></div>'+
 '<div class="wcCtl"><button class="btn primary" data-a="snap">📸 Snapshot</button><button class="btn" data-a="pause">⏸ Freeze</button><button class="btn on" data-a="mirror">⇋ Mirror</button><button class="btn" data-a="power">⏻ Stop</button><select aria-label="Filter">'+Object.keys(FL).map(k=>'<option>'+k+'</option>').join('')+'</select></div>'+
 '<div class="wcSize"><span>SIZE</span><input type="range" min="220" max="1100" value="380" aria-label="Window size"><button class="btn" data-s="260">S</button><button class="btn" data-s="380">M</button><button class="btn" data-s="560">L</button><button class="btn" data-s="820">XL</button></div></div><div class="wcRs" title="Drag to resize"></div>';
 document.body.appendChild(el);el.classList.add('mounted');
 const $$=s=>el.querySelector(s),V=$$('.wcV'),vid=$$('video'),msg=$$('.wcMsg'),info=$$('.wcInfo'),sel=$$('select'),sl=$$('input[type=range]'),bar=$$('.cwBar'),rs=$$('.wcRs'),pw=$$('[data-a=power]'),pa=$$('[data-a=pause]');
 const o=cam={el,stream:null,closed:false};let ratio=16/9,prevW=380,mirror=true;
 const maxW=()=>Math.min(innerWidth-8,1100),minW=()=>Math.min(220,innerWidth-8);
 const fit=()=>{el.style.left=clamp(el.offsetLeft,4,Math.max(4,innerWidth-el.offsetWidth-4))+'px';el.style.top=clamp(el.offsetTop,4,Math.max(4,innerHeight-Math.min(el.offsetHeight,90)-4))+'px'};
 const setW=w=>{w=clamp(w,minW(),maxW());el.style.width=w+'px';sl.value=w;sl.max=maxW()};
 setW(380);el.style.left=Math.max(8,(innerWidth-el.offsetWidth)/2)+'px';el.style.top=Math.max(72,innerHeight*.14)+'px';fit();
 el.style.zIndex=93;void el.offsetWidth;el.classList.add('visible','play');setTimeout(()=>el.classList.remove('play'),1000);
 const show=(icon,t,cls)=>{msg.className='wcMsg '+(cls||'');msg.innerHTML='<b>'+icon+'</b><span>'+t+'</span>';V.classList.remove('live')};
 const stopStream=()=>{o.stream&&o.stream.getTracks().forEach(t=>t.stop());o.stream=null;vid.srcObject=null};
 const off=()=>{stopStream();show('◌','Camera is off','');pw.textContent='⏻ Start';pw.classList.remove('on');pa.textContent='⏸ Freeze'};
 async function start(){
  const md=navigator.mediaDevices;if(!md||!md.getUserMedia)return show('⚠','Camera API unavailable.<br>Open this page via https:// or localhost.','err');
  show('◔','Waiting for camera permission…','wait');stopStream();
  try{
   let s;const v={width:{ideal:1280},height:{ideal:720}};
   try{s=await md.getUserMedia({video:{...v,facingMode:{exact:'user'}},audio:false})}
   catch(e){if(e.name==='OverconstrainedError'||e.name==='ConstraintNotSatisfiedError')s=await md.getUserMedia({video:{...v,facingMode:'user'},audio:false});else throw e}
   if(o.closed){s.getTracks().forEach(t=>t.stop());return}
   const t=s.getVideoTracks()[0],st=t.getSettings();
   if(st.facingMode==='environment'){s.getTracks().forEach(x=>x.stop());return show('⚠','Only the front camera is allowed.<br>No front camera detected.','err')}
   o.stream=s;vid.srcObject=s;t.onended=()=>{if(!o.closed)off()};
   await vid.play().catch(()=>{});
   const ready=()=>{const w=vid.videoWidth,h=vid.videoHeight;if(!w)return;ratio=w/h;V.style.aspectRatio=w+' / '+h;const g=t.getSettings();info.textContent=w+'×'+h+' · '+Math.round(g.frameRate||30)+'fps';V.classList.add('live');pw.textContent='⏻ Stop';pw.classList.add('on');setTimeout(fit,50)};
   vid.videoWidth?ready():vid.addEventListener('loadedmetadata',ready,{once:true});
  }catch(e){const n=e&&e.name;show('⚠',n==='NotAllowedError'||n==='SecurityError'?'Camera permission blocked.<br>Allow it in your browser’s site settings, then press Start.':n==='NotFoundError'||n==='OverconstrainedError'?'No front camera found.':n==='NotReadableError'?'Camera is being used by another app.':'Could not start camera ('+(n||'error')+').','err');pw.textContent='⏻ Start';pw.classList.remove('on')}}
 o.close=()=>{if(o.closed)return;o.closed=true;stopStream();el.classList.remove('visible');cam=null;setTimeout(()=>el.remove(),400)};
 const dots=el.querySelectorAll('.dot');
 dots[0].onclick=o.close;dots[1].onclick=()=>el.classList.toggle('min');
 dots[2].onclick=()=>{el.classList.remove('min');const w=el.offsetWidth;if(w<maxW()-20){prevW=w;setW(maxW())}else setW(prevW);setTimeout(fit,420)};
 bar.addEventListener('dblclick',e=>{if(!e.target.closest('.dot'))el.classList.toggle('min')});
 el.addEventListener('pointerdown',()=>{el.style.zIndex=93},true);
 bar.addEventListener('pointerdown',e=>{if(e.target.closest('.dot')||e.button>0)return;
  const dx=e.clientX-el.offsetLeft,dy=e.clientY-el.offsetTop;el.classList.add('dragging');bar.setPointerCapture(e.pointerId);
  const mv=v=>{el.style.left=clamp(v.clientX-dx,4,Math.max(4,innerWidth-el.offsetWidth-4))+'px';el.style.top=clamp(v.clientY-dy,4,Math.max(4,innerHeight-Math.min(el.offsetHeight,90)-4))+'px'};
  const up=()=>{el.classList.remove('dragging');bar.removeEventListener('pointermove',mv);bar.removeEventListener('pointerup',up);bar.removeEventListener('pointercancel',up)};
  bar.addEventListener('pointermove',mv);bar.addEventListener('pointerup',up);bar.addEventListener('pointercancel',up)});
 rs.addEventListener('pointerdown',e=>{e.preventDefault();const x0=e.clientX,y0=e.clientY,w0=el.offsetWidth;el.classList.add('rsz');rs.setPointerCapture(e.pointerId);
  const mv=v=>{setW(w0+Math.max(v.clientX-x0,(v.clientY-y0)*ratio));fit()};
  const up=()=>{el.classList.remove('rsz');rs.removeEventListener('pointermove',mv);rs.removeEventListener('pointerup',up);rs.removeEventListener('pointercancel',up)};
  rs.addEventListener('pointermove',mv);rs.addEventListener('pointerup',up);rs.addEventListener('pointercancel',up)});
 sl.oninput=()=>{el.classList.add('rsz');setW(+sl.value);fit()};sl.onchange=()=>el.classList.remove('rsz');
 sel.onchange=()=>{vid.style.filter=FL[sel.value]};
 el.querySelectorAll('[data-s]').forEach(b=>b.onclick=()=>{setW(+b.dataset.s);setTimeout(fit,420)});
 el.querySelector('.wcCtl').addEventListener('click',e=>{const b=e.target.closest('[data-a]');if(!b)return;const a=b.dataset.a;
  if(a==='mirror'){mirror=!mirror;V.classList.toggle('nomirror',!mirror);b.classList.toggle('on',mirror)}
  else if(a==='power')o.stream?off():start();
  else if(a==='pause'){if(!o.stream)return;if(vid.paused){vid.play();b.textContent='⏸ Freeze'}else{vid.pause();b.textContent='▶ Resume'}}
  else if(a==='snap'){if(!o.stream||!vid.videoWidth)return toast('Camera is not live');
   const c=document.createElement('canvas');c.width=vid.videoWidth;c.height=vid.videoHeight;const x=c.getContext('2d');x.filter=FL[sel.value];if(mirror){x.translate(c.width,0);x.scale(-1,1)}x.drawImage(vid,0,0);
   const f=$$('.wcFlash');f.classList.remove('go');void f.offsetWidth;f.classList.add('go');
   c.toBlob(bl=>{const d=new Date(),p=n=>String(n).padStart(2,'0'),l=document.createElement('a');l.href=URL.createObjectURL(bl);l.download='webcam-'+d.getFullYear()+p(d.getMonth()+1)+p(d.getDate())+'-'+p(d.getHours())+p(d.getMinutes())+p(d.getSeconds())+'.png';l.click();setTimeout(()=>URL.revokeObjectURL(l.href),4000);toast('📸 Snapshot saved')})}});
 addEventListener('resize',()=>{if(!o.closed){setW(el.offsetWidth);fit()}});
 addEventListener('pagehide',()=>o.closed||stopStream());
 start()}
const menu=$('vmenu'),g=[...menu.querySelectorAll('.vmGroup')].find(x=>/tools hub/.test(x.textContent));
const h='<div class="vmGroup">// media</div><button class="vmWeb" type="button"><span class="vmIco">📷</span>Web Cam<span class="vmTag">FRONT</span></button>';
g?g.insertAdjacentHTML('beforebegin',h):menu.insertAdjacentHTML('beforeend',h);
const b=menu.querySelector('.vmWeb');
b.addEventListener('pointerdown',e=>{const r=b.getBoundingClientRect(),s=Math.max(r.width,r.height),p=document.createElement('span');p.className='ripple';p.style.cssText='width:'+s+'px;height:'+s+'px;left:'+(e.clientX-r.left-s/2)+'px;top:'+(e.clientY-r.top-s/2)+'px';b.appendChild(p);setTimeout(()=>p.remove(),560)});
b.addEventListener('click',()=>{$('vmScrim').click();setTimeout(openCam,150)});
})();
</script>
<script id="vocode-webcam-script">
(()=>{
'use strict';
const $=id=>document.getElementById(id),clamp=(v,a,b)=>Math.max(a,Math.min(b,v));
const toast=m=>{const el=$('toast');if(!el)return;el.textContent=m;el.classList.add('show');clearTimeout(toast.t);toast.t=setTimeout(()=>el.classList.remove('show'),1900)};
const FL=[['Normal','none'],['Mono','grayscale(1) contrast(1.1)'],['Noir','grayscale(1) contrast(1.5) brightness(.85)'],['Cool','saturate(1.15) hue-rotate(-12deg) brightness(1.05)'],['Warm','sepia(.35) saturate(1.3)']];
const SZ=[['S',280],['M',420],['L',640],['XL',900]];
const MSG={NotAllowedError:'Camera permission denied.\nAllow it in the browser address bar, then press Start.',NotFoundError:'No camera found on this device.',NotReadableError:'Camera is being used by another app.',RearOnly:'Only a rear camera was found.\nThis tool uses the front camera only.',SecurityError:'Camera blocked by browser security.',OverconstrainedError:'Front camera not available.',NoAPI:'Camera API unavailable.\nOpen this file via https:// or localhost.'};
let win=null,z=76;
const rear=l=>/back|rear|environment|belakang/i.test(l||'');
function openCam(){
 if(win){win.classList.remove('min');win.style.zIndex=++z;return}
 const el=document.createElement('div');win=el;el.className='calcWin tw camWin';el.setAttribute('role','dialog');
 el.innerHTML='<div class="cwSweep"><i></i></div><div class="cwBar"><div class="cwDots"><button class="dot dot-red" type="button" aria-label="Close"></button><button class="dot dot-yellow" type="button" aria-label="Minimize"></button><button class="dot dot-green" type="button" aria-label="Next size"></button></div><div class="cwTitle"><b>const</b> webcam.js</div></div>'+
 '<div class="cwBody"><div class="camStage" data-st="idle"><video muted playsinline autoplay></video><i class="cb tl"></i><i class="cb tr"></i><i class="cb bl"></i><i class="cb br"></i><span class="camLive"><i></i>LIVE</span><span class="camRes">--</span>'+
 '<div class="camMsg"><div class="ic">◉</div><div class="camRing"></div><p>Camera off</p><button class="btn primary" data-a="go">▶ Start camera</button></div><div class="camFlash"></div></div>'+
 '<div class="camBar"><button class="btn" data-a="snap" title="Snapshot">📷 Snap</button><button class="btn on" data-a="mir" title="Mirror">⇋ Mirror</button><button class="btn" data-a="fx" title="Filter">◐ Normal</button><button class="btn" data-a="pip" title="Picture in picture">⧉</button><button class="btn" data-a="fs" title="Fullscreen">⛶</button><button class="btn" data-a="stop" title="Stop camera">■ Stop</button><div class="camSz">'+SZ.map((s,i)=>'<button class="btn" data-sz="'+i+'">'+s[0]+'</button>').join('')+'</div></div><div class="camThumbs"></div></div><div class="camGrip" title="Drag to resize"></div>';
 document.body.appendChild(el);
 const $$=s=>el.querySelector(s),st=$$('.camStage'),v=$$('video'),res=$$('.camRes'),msg=$$('.camMsg p'),th=$$('.camThumbs'),fxb=$$('[data-a=fx]'),mirb=$$('[data-a=mir]');
 let stream=null,mir=true,fi=0,tm=0,frames=0,fpsV=0,lt=performance.now(),urls=[],cw=+localStorage.getItem('VOCODE_CAM_W')||420;
 const setSt=(s,t)=>{st.dataset.st=s;if(t!==undefined)msg.textContent=t};
 const setW=(w,anim)=>{cw=clamp(Math.round(w),240,Math.min(1100,innerWidth-8));el.style.width=cw+'px';el.querySelectorAll('[data-sz]').forEach(b=>b.classList.toggle('on',Math.abs(SZ[b.dataset.sz][1]-cw)<24));if(anim)setTimeout(fit,420)};
 const fit=()=>{el.style.left=clamp(el.offsetLeft,4,Math.max(4,innerWidth-el.offsetWidth-4))+'px';el.style.top=clamp(el.offsetTop,4,Math.max(4,innerHeight-120))+'px'};
 setW(cw);el.classList.add('mounted');el.style.left=Math.max(8,innerWidth-el.offsetWidth-24)+'px';el.style.top='84px';el.style.zIndex=++z;
 void el.offsetWidth;el.classList.add('visible','play');setTimeout(()=>el.classList.remove('play'),1000);
 const apply=()=>{v.style.transform=mir?'scaleX(-1)':'none';v.style.filter=FL[fi][1];mirb.classList.toggle('on',mir);fxb.textContent='◐ '+FL[fi][0]};apply();

 /* camera — FRONT ONLY */
 const gum=c=>navigator.mediaDevices.getUserMedia({audio:false,video:Object.assign({width:{ideal:1280},height:{ideal:720}},c)});
 async function front(s){const t=s.getVideoTracks()[0],k=t.getSettings();
  if(k.facingMode!=='environment'&&!rear(t.label))return s;
  s.getTracks().forEach(x=>x.stop());
  const d=(await navigator.mediaDevices.enumerateDevices()).filter(x=>x.kind==='videoinput'&&!rear(x.label)&&x.deviceId!==k.deviceId);
  if(!d.length)throw{name:'RearOnly'};
  const s2=await gum({deviceId:{exact:d[0].deviceId}});if(s2.getVideoTracks()[0].getSettings().facingMode==='environment'){s2.getTracks().forEach(x=>x.stop());throw{name:'RearOnly'}}return s2}
 async function start(){
  if(stream)return;if(!navigator.mediaDevices||!navigator.mediaDevices.getUserMedia)return setSt('err',MSG.NoAPI);
  setSt('wait','Waiting for camera…');
  try{let s=await gum({facingMode:'user'});s=await front(s);stream=s;v.srcObject=s;await v.play();
   s.getVideoTracks()[0].addEventListener('ended',()=>{halt();setSt('err','Camera disconnected.')});
   setSt('live');st.classList.remove('reveal');void st.offsetWidth;st.classList.add('reveal');el.classList.remove('play');void el.offsetWidth;el.classList.add('play');setTimeout(()=>el.classList.remove('play'),1000);
   const k=s.getVideoTracks()[0].getSettings();fpsV=Math.round(k.frameRate||0);
   if(v.requestVideoFrameCallback){const f=()=>{frames++;if(stream)v.requestVideoFrameCallback(f)};v.requestVideoFrameCallback(f)}
   clearInterval(tm);tm=setInterval(()=>{const n=performance.now();if(v.requestVideoFrameCallback){fpsV=Math.round(frames*1000/(n-lt));frames=0;lt=n}res.textContent=v.videoWidth+'×'+v.videoHeight+' · '+fpsV+' fps · front'},800)
  }catch(e){stream=null;setSt('err',MSG[e&&e.name]||('Camera error: '+(e&&e.message||e)))}}
 function halt(){clearInterval(tm);if(stream)stream.getTracks().forEach(t=>t.stop());stream=null;v.srcObject=null}
 function stop(){halt();setSt('idle','Camera off')}

 function snap(){if(!stream||!v.videoWidth)return toast('Start the camera first');
  const c=document.createElement('canvas');c.width=v.videoWidth;c.height=v.videoHeight;const x=c.getContext('2d');x.filter=FL[fi][1];if(mir){x.translate(c.width,0);x.scale(-1,1)}x.drawImage(v,0,0);
  const f=$$('.camFlash');f.classList.remove('go');void f.offsetWidth;f.classList.add('go');
  c.toBlob(b=>{const u=URL.createObjectURL(b);urls.push(u);const i=new Image();i.src=u;i.title='Click to save';i.onclick=()=>{const a=document.createElement('a');a.href=u;a.download='webcam-'+new Date().toISOString().replace(/[:.]/g,'-').slice(0,19)+'.png';a.click();toast('✓ Saved')};th.prepend(i);while(th.children.length>5)th.lastChild.remove();toast('📷 Snapshot — click thumbnail to save')})}

 el.addEventListener('click',e=>{const b=e.target.closest('[data-a],[data-sz]');if(!b)return;
  if(b.dataset.sz!==undefined)return setW(SZ[b.dataset.sz][1],1);
  const a=b.dataset.a;
  if(a==='go')start();else if(a==='stop')stop();else if(a==='snap')snap();
  else if(a==='mir'){mir=!mir;apply()}else if(a==='fx'){fi=(fi+1)%FL.length;apply()}
  else if(a==='fs'){st.requestFullscreen?st.requestFullscreen():toast('Fullscreen not supported')}
  else if(a==='pip'){document.pictureInPictureEnabled&&stream?v.requestPictureInPicture().catch(()=>toast('PiP unavailable')):toast('PiP needs a live camera')}});
 const d=el.querySelectorAll('.dot');
 d[0].onclick=()=>{halt();urls.forEach(URL.revokeObjectURL);el.classList.remove('visible');win=null;setTimeout(()=>el.remove(),380)};
 d[1].onclick=()=>el.classList.toggle('min');
 d[2].onclick=()=>{el.classList.remove('min');const i=SZ.findIndex(s=>s[1]>cw+24);setW(SZ[i<0?0:i][1],1)};
 el.addEventListener('pointerdown',()=>{el.style.zIndex=++z},true);
 const bar=$$('.cwBar');
 bar.addEventListener('dblclick',e=>{if(!e.target.closest('.dot'))el.classList.toggle('min')});
 bar.addEventListener('pointerdown',e=>{if(e.target.closest('.dot')||e.button>0)return;const dx=e.clientX-el.offsetLeft,dy=e.clientY-el.offsetTop;el.classList.add('dragging');bar.setPointerCapture(e.pointerId);
  const mv=m=>{el.style.left=clamp(m.clientX-dx,4,Math.max(4,innerWidth-el.offsetWidth-4))+'px';el.style.top=clamp(m.clientY-dy,4,Math.max(4,innerHeight-Math.min(el.offsetHeight,90)-4))+'px'};
  const up=()=>{el.classList.remove('dragging');bar.removeEventListener('pointermove',mv);bar.removeEventListener('pointerup',up);bar.removeEventListener('pointercancel',up)};
  bar.addEventListener('pointermove',mv);bar.addEventListener('pointerup',up);bar.addEventListener('pointercancel',up)});
 const g=$$('.camGrip');
 g.addEventListener('pointerdown',e=>{e.preventDefault();e.stopPropagation();const x0=e.clientX,y0=e.clientY,w0=el.offsetWidth;el.classList.add('rs');g.setPointerCapture(e.pointerId);
  const mv=m=>setW(w0+((m.clientX-x0)+(m.clientY-y0)*1.78)/2);
  const up=()=>{el.classList.remove('rs');localStorage.setItem('VOCODE_CAM_W',cw);fit();g.removeEventListener('pointermove',mv);g.removeEventListener('pointerup',up);g.removeEventListener('pointercancel',up)};
  g.addEventListener('pointermove',mv);g.addEventListener('pointerup',up);g.addEventListener('pointercancel',up)});
 addEventListener('resize',()=>{if(win===el){setW(cw);fit()}});
 setTimeout(start,350)}

/* menu entry */
const menu=$('vmenu'),hub=[...menu.querySelectorAll('.vmGroup')].find(x=>/tools hub/.test(x.textContent));
const html='<div class="vmGroup">// camera</div><button class="vmCam" id="vmCam"><span class="vmIco">◉</span>Web Cam<span class="vmTag">FRONT</span></button>';
hub?hub.insertAdjacentHTML('beforebegin',html):menu.insertAdjacentHTML('beforeend',html);
const b=$('vmCam');
b.addEventListener('pointerdown',e=>{const r=b.getBoundingClientRect(),s=Math.max(r.width,r.height),p=document.createElement('span');p.className='ripple';p.style.cssText='width:'+s+'px;height:'+s+'px;left:'+(e.clientX-r.left-s/2)+'px;top:'+(e.clientY-r.top-s/2)+'px';b.appendChild(p);setTimeout(()=>p.remove(),560)});
b.addEventListener('click',()=>{$('vmScrim').click();setTimeout(openCam,150)});
})();
</script>
</body>
</html>
