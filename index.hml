FM('dev','{ }','JSON Viewer','Membaca JSON dengan tampilan terstruktur',{html:1,ed:1,w:420,in:[{l:'JSON',ta:5}],live:1,go:v=>'<div>'+tree(JSON.parse(v[0]))+'</div>'});
