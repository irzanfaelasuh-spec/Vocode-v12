add('proj','◷','Recent Projects','Menampilkan project yang terakhir dibuka',()=>{
 const w=makeWin('recent',TT('Recent'),340);if(!w)return;const a=ls('VOCODE_PROJECTS_V3',[]);
 w.body.innerHTML='<div class="twF">'+(a.slice(0,10).map((p,i)=>'<button class="btn rc" data-i="'+i+'">▰ '+esc(p.name||'Untitled')+'</button>').join('')||'<div class="dimtxt">no saved projects — press Save first</div>')+'</div>';
 w.body.onclick=e=>{const b=e.target.closest('.rc');if(!b)return;const t=q('.projectItem[data-project-index="'+b.dataset.i+'"]');t?(t.click(),toast('✓ Opened '+b.textContent.slice(2))):toast('Project not found')}});
const TPL={
 Counter:{d:'Tombol +/− dengan animasi',html:'<main><h1 id="n">0</h1><button id="m">−</button><button id="p">+</button></main>',css:'body{margin:0;min-height:100vh;display:grid;place-items:center;background:#070b12;color:#e5edf7;font-family:system-ui}main{text-align:center}h1{font-size:88px;margin:0 0 16px;transition:transform .2s}button{width:54px;height:54px;margin:4px;border:1px solid #2a435c;border-radius:14px;background:#0d1824;color:#7dd3fc;font-size:24px;cursor:pointer;transition:.15s}button:hover{box-shadow:0 0 24px #38bdf844;transform:translateY(-2px)}button:active{transform:scale(.9)}',js:'let n=0;const e=document.getElementById("n");function s(d){n+=d;e.textContent=n;e.style.transform="scale(1.15)";setTimeout(()=>e.style.transform="",120)}p.onclick=()=>s(1);m.onclick=()=>s(-1);'},
 Particles:{d:'Canvas partikel terhubung garis',html:'<canvas id="c"></canvas>',css:'body{margin:0;overflow:hidden;background:#050a10}canvas{display:block}',js:'const c=document.getElementById("c"),x=c.getContext("2d");let W,H;function r(){W=c.width=innerWidth;H=c.height=innerHeight}r();onresize=r;const P=Array.from({length:70},()=>({x:Math.random()*W,y:Math.random()*H,vx:Math.random()-.5,vy:Math.random()-.5}));(function f(){x.clearRect(0,0,W,H);P.forEach((p,i)=>{p.x=(p.x+p.vx+W)%W;p.y=(p.y+p.vy+H)%H;x.fillStyle="#7dd3fc";x.fillRect(p.x,p.y,2,2);for(let j=i+1;j<P.length;j++){const d=Math.hypot(p.x-P[j].x,p.y-P[j].y);if(d<110){x.strokeStyle="rgba(56,189,248,"+(1-d/110)*.4+")";x.beginPath();x.moveTo(p.x,p.y);x.lineTo(P[j].x,P[j].y);x.stroke()}}});requestAnimationFrame(f)})();'},
 Todo:{d:'To-do list sederhana',html:'<main><h2>Todo</h2><input id="i" placeholder="Add task, press Enter"><ul id="l"></ul></main>',css:'body{margin:0;min-height:100vh;display:grid;place-items:start center;padding-top:60px;background:#070b12;color:#e5edf7;font-family:system-ui}main{width:min(360px,90vw)}input{width:100%;padding:11px;border-radius:10px;border:1px solid #2a435c;background:#0d1824;color:#fff}ul{list-style:none;padding:0}li{padding:10px 12px;margin:6px 0;border-radius:10px;background:#0d1824;border:1px solid #1b2a3b;cursor:pointer;animation:in .3s}li.d{text-decoration:line-through;opacity:.5}@keyframes in{from{opacity:0;transform:translateY(8px)}}',js:'i.onkeydown=e=>{if(e.key==="Enter"&&i.value.trim()){const li=document.createElement("li");li.textContent=i.value;li.onclick=()=>li.classList.toggle("d");li.ondblclick=()=>li.remove();l.prepend(li);i.value=""}}'}};
add('proj','▦','Project Templates','Membuat project dari template siap pakai',()=>{
 const w=makeWin('tpl',TT('Templates'),360);if(!w)return;
 w.body.innerHTML='<div class="twF">'+Object.keys(TPL).map(k=>'<button class="btn rc" data-k="'+k+'"><b>'+k+'</b> — '+TPL[k].d+'</button>').join('')+'<div class="dimtxt">Replaces the 3 editor files (Ctrl+Z to undo).</div></div>';
 w.body.onclick=e=>{const b=e.target.closest('.rc');if(!b)return;const t=TPL[b.dataset.k],k=cur();['html','css','js'].forEach(f=>{q('.tab[data-file="'+f+'"]').click();cm().setValue(t[f])});q('.tab[data-file="'+k+'"]').click();$('runBtn').click();toast('✓ Template: '+b.dataset.k)}});
FM('proj','ⓘ','Project Info','Melihat informasi project',{auto:1,btn:'↻ Refresh',go:()=>{const F=files();let o='name      '+$('projectName').value+'\nsaved     '+ls('VOCODE_PROJECTS_V3',[]).length+' project(s)\n\n';for(const k in F)o+=FN[k].padEnd(11)+F[k].split('\n').length+' lines · '+new Blob([F[k]]).size+' B\n';return o}});
FM('proj','⌕','Project Search','Mencari teks di seluruh project',{html:1,in:[{l:'Search all files',ph:'text…'}],btn:'⌕ Search',go:v=>{if(!v[0])return 'type something, press Enter';const F=files();let n=0,h='';for(const k in F)F[k].split('\n').forEach((l,i)=>{if(n<100&&l.toLowerCase().includes(v[0].toLowerCase())){n++;h+='<div class="hit" data-p="'+k+':'+i+'"><b>'+FN[k]+':'+(i+1)+'</b>'+esc(l.trim().slice(0,90))+'</div>'}});return h||'no results'},pick:p=>{const[k,i]=p.dataset.p.split(':');q('.tab[data-file="'+k+'"]').click();const c=cm();c.setCursor({line:+i,ch:0});c.scrollIntoView({line:+i,ch:0},200);c.focus()}});
add('proj','▤','ZIP Project','Mengemas project menjadi .zip',()=>{if(!window.JSZip)return toast('JSZip failed to load (offline?)');const F=files(),z=new JSZip(),n=($('projectName').value||'project').replace(/\W+/g,'-');for(const k in F)z.file(FN[k],F[k]);z.generateAsync({type:'blob'}).then(b=>{const a=document.createElement('a');a.href=URL.createObjectURL(b);a.download=n+'.zip';a.click();setTimeout(()=>URL.revokeObjectURL(a.href),4000);toast('✓ '+n+'.zip')})});

/* ── RUN & PREVIEW ── */
const pv=()=>{if(!$('previewFrame').offsetParent)$('mobilePreviewBtn').click()};
add('run','◉','Live Preview','Melihat hasil website secara langsung',()=>{pv();$('runBtn').click()});
add('run','↻','Refresh Preview','Memuat ulang preview',()=>{$('runBtn').click();toast('↻ Preview refreshed')});
add('run','⧉','Open Preview Window','Membuka hasil dalam window terpisah',()=>$('screenBtn').click());
add('run','⛶','Fullscreen Preview','Membuat preview memenuhi layar',()=>{pv();const f=$('previewFrame');f.requestFullscreen?f.requestFullscreen():toast('Fullscreen not supported')});
const frame=(w,h)=>{const f=$('previewFrame');f.style.width=w?w+'px':'100%';f.style.height=h?h+'px':'100%';f.style.maxWidth='100%';f.style.maxHeight='100%';f.style.margin='0 auto'};
add('run','▯','Device Preview','Simulasi tampilan HP/tablet/desktop',()=>{
 const w=makeWin('devp',TT('Device'),340);if(!w)return;pv();let cw=0,ch=0;
 w.body.innerHTML='<div class="twF"><div class="twRow"><button class="btn" data-w="375" data-h="667">📱 Phone</button><button class="btn" data-w="768" data-h="1024">📟 Tablet</button><button class="btn" data-w="1280" data-h="720">🖥 Desktop</button><button class="btn" data-w="0" data-h="0">⤢ Fit</button><button class="btn" data-r="1">⟳ Rotate</button></div><div class="twOut">Fit</div></div>';
 const o=w.body.querySelector('.twOut');w.onClose=()=>frame(0,0);
 w.body.onclick=e=>{const b=e.target.closest('button');if(!b)return;if(b.dataset.r){[cw,ch]=[ch,cw]}else{cw=+b.dataset.w;ch=+b.dataset.h}frame(cw,ch);o.textContent=cw?cw+' × '+ch:'Fit'}});
const mon=(g,i,n,d,get,unit,max,note)=>add(g,i,n,d,()=>{
 const w=makeWin('m:'+n,TT(n),340);if(!w)return;
 w.body.innerHTML='<div class="monVal"><b>--</b> <span>'+unit+'</span></div><canvas class="monC" width="640" height="152"></canvas><div class="monNote">'+note+'</div>';
 const c=w.body.querySelector('canvas'),x=c.getContext('2d'),vl=w.body.querySelector('b'),D=[];
 const t=setInterval(()=>{const v=get();if(isNaN(v)){vl.textContent='n/a';return}D.push(v);D.length>60&&D.shift();vl.textContent=v.toFixed(v<10?1:0);
  x.clearRect(0,0,640,152);x.strokeStyle='#16283a';x.lineWidth=1;for(let y=38;y<152;y+=38){x.beginPath();x.moveTo(0,y);x.lineTo(640,y);x.stroke()}
  const m=Math.max(max,...D),p=i2=>[i2*(640/59),148-D[i2]/m*140];x.beginPath();D.forEach((_,i2)=>{const[a,b]=p(i2);i2?x.lineTo(a,b):x.moveTo(a,b)});
  x.strokeStyle='#38bdf8';x.lineWidth=2.5;x.stroke();x.lineTo(p(D.length-1)[0],152);x.lineTo(p(0)[0],152);const g=x.createLinearGradient(0,0,0,152);g.addColorStop(0,'#38bdf844');g.addColorStop(1,'#38bdf800');x.fillStyle=g;x.fill()},500);
 w.onClose=()=>clearInterval(t)});
mon('run','◔','FPS Monitor','Menampilkan FPS secara realtime',()=>fps,'fps',60,'requestAnimationFrame rate of this tab');
mon('run','▤','Memory Monitor','Memantau penggunaan memory',()=>performance.memory?performance.memory.usedJSHeapSize/1048576:NaN,'MB',50,'JS heap · Chrome/Edge only');
FM('run','◈','Performance Monitor','Melihat penggunaan performa aplikasi',{auto:1,btn:'↻ Refresh',go:()=>{const n=performance.getEntriesByType('navigation')[0]||{},p=performance.getEntriesByName('first-contentful-paint')[0],m=performance.memory;return['TTFB            '+Math.round(n.responseStart||0)+' ms','DOM ready       '+Math.round(n.domContentLoadedEventEnd||0)+' ms','Load            '+Math.round(n.loadEventEnd||0)+' ms','First paint     '+(p?Math.round(p.startTime)+' ms':'n/a'),'Event-loop lag  '+lag.toFixed(1)+' ms','FPS             '+fps,'JS heap         '+(m?(m.usedJSHeapSize/1048576).toFixed(1)+' / '+(m.jsHeapSizeLimit/1048576).toFixed(0)+' MB':'n/a (Chrome only)'),'Resources       '+performance.getEntriesByType('resource').length].join('\n')}});
FM('run','⇅','Network Monitor','Melihat request website/API',{auto:1,btn:'↻ Refresh',w:460,go:()=>performance.getEntriesByType('resource').slice(-40).map(r=>String(Math.round(r.duration)).padStart(5)+' ms  '+((r.transferSize||0)/1024).toFixed(1).padStart(7)+' KB  '+r.name.replace(/^https?:\/\//,'').slice(0,60)).join('\n')||'no requests yet'});

/* ── TERMINAL & SYSTEM ── */
const HK='VOCODE_TERM_HIST';let H=ls(HK,[]);
function terminal(){
 const w=makeWin('term','<b>$</b> vocode — terminal',520);if(!w)return;
 w.body.innerHTML='<div class="twF"><div class="trm"><div class="trmOut"></div><div class="trmIn"><span>❯</span><input spellcheck="false" autocomplete="off" placeholder="type help"></div></div></div>';
 const out=w.body.querySelector('.trmOut'),inp=w.body.querySelector('input');let hi=H.length;
 const P=(t,c)=>{const d=document.createElement('div');d.textContent=t;if(c)d.className=c;out.appendChild(d);out.scrollTop=out.scrollHeight};w.clear=()=>out.innerHTML='';
 const fk={html:'html','index.html':'html',css:'css','style.css':'css',js:'js','script.js':'js'};
 const C={help:()=>P('help  clear  ls  cat <html|css|js>  date  echo <t>  calc <expr>\nrun  stop  save  theme <name>  open <tool>  history  info'),clear:()=>w.clear(),ls:()=>P('index.html  style.css  script.js'),date:()=>P(new Date().toString()),
  echo:a=>P(a.join(' ')),calc:a=>P(String(sci(a.join(' ')))),run:()=>{$('runBtn').click();P('▶ running')},stop:()=>{$('stopBtn').click();P('■ stopped')},save:()=>{$('saveBtn').click();P('✓ saved')},
  cat:a=>{const k=fk[a[0]];if(!k)throw Error('usage: cat <html|css|js>');P(files()[k])},theme:a=>{if(!TH[a[0]])throw Error('themes: '+Object.keys(TH).join(', '));theme(a[0]);P('✓ '+a[0])},
  open:a=>{const t=TOOLS.find(x=>x.n.toLowerCase().includes(a.join(' ').toLowerCase()));if(!t||!a.length)throw Error('no tool: '+a.join(' '));t.run();P('opened '+t.n)},history:()=>H.forEach((h,i)=>P((i+1)+'  '+h)),
  info:()=>P('VOCODE · '+innerWidth+'×'+innerHeight+' · '+fps+' fps · '+navigator.language)};
 P('VOCODE terminal — type "help"','dim');
 inp.onkeydown=e=>{if(e.key==='Enter'){const v=inp.value.trim();inp.value='';if(!v)return;P('❯ '+v,'cmd');H.push(v);H=H.slice(-100);ss(HK,H);hi=H.length;const[c,...a]=v.split(/\s+/);try{if(!C[c])throw Error('command not found: '+c);C[c](a)}catch(x){P(x.message,'err')}}
  else if(e.key==='ArrowUp'){hi=Math.max(0,hi-1);inp.value=H[hi]||'';e.preventDefault()}else if(e.key==='ArrowDown'){hi=Math.min(H.length,hi+1);inp.value=H[hi]||'';e.preventDefault()}};
 setTimeout(()=>inp.focus(),380)}
add('sys','❯','Terminal','Membuka terminal bawaan VOCODE',terminal);
FM('sys','↺','Command History','Melihat command yang pernah dijalankan',{auto:1,btn:'↻ Refresh',go:()=>ls(HK,[]).map((h,i)=>String(i+1).padStart(3)+'  '+h).join('\n')||'empty'});
add('sys','⌫','Clear Terminal','Membersihkan terminal',()=>{terminal();W.term&&W.term.clear&&W.term.clear();toast('✓ Terminal cleared')});
mon('sys','▥','System Monitor','Melihat informasi CPU/RAM',()=>lag,'ms lag',50,'Event-loop lag · '+(navigator.hardwareConcurrency||'?')+' cores · '+(navigator.deviceMemory?navigator.deviceMemory+' GB RAM':'RAM n/a'));
FM('sys','ⓔ','Environment Info','Melihat informasi environment',{auto:1,btn:'↻ Refresh',go:()=>['Browser   '+navigator.userAgent,'Platform  '+(navigator.userAgentData?.platform||navigator.platform),'Language  '+navigator.language,'Timezone  '+Intl.DateTimeFormat().resolvedOptions().timeZone,'Screen    '+screen.width+'×'+screen.height+' @'+devicePixelRatio+'x','Viewport  '+innerWidth+'×'+innerHeight,'Cores     '+(navigator.hardwareConcurrency||'?'),'Online    '+navigator.onLine,'Storage   '+Object.keys(localStorage).length+' localStorage keys'].join('\n')});
FM('sys','⌨','Keyboard Shortcuts','Melihat shortcut VOCODE',{auto:1,btn:'↻',go:()=>'Ctrl+K        Command Palette\nCtrl+P        Quick Open\nCtrl+G        Go to Line\nCtrl+/        Comment / Uncomment\nEsc           Close palette / exit Zen\n\nCalculator: 0-9 + - * / ^ % ( ) Enter Backspace Del'});

